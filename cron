#!/bin/bash

set -e

# Das Verzeichnis des aktuellen Skripts ermitteln
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

SHOW_SCRIPT="$SCRIPT_DIR/show" # Pfad zum `show`-Skript

# Überprüfen, ob das `show`-Skript ausführbar ist
if [ ! -x "$SHOW_SCRIPT" ]; then
    echo "❌ Fehler: Das 'show'-Skript ist nicht ausführbar oder nicht vorhanden."
    exit 1
fi

# Rekursive Suche nach PDF-Dateien im Skriptverzeichnis
echo "🔍 Suche nach PDF-Dateien im Verzeichnis '$SCRIPT_DIR'..."
find "$SCRIPT_DIR" -type f -name "*.pdf" | while read -r PDF_FILE; do
    TXT_FILE="${PDF_FILE%.pdf}.txt"

    # Wenn die TXT-Datei existiert, sie überspringen
    if [ -f "$TXT_FILE" ]; then
        echo "✅ Überspringe: $TXT_FILE existiert bereits."
    else
        # Andernfalls, das `show`-Skript für die PDF-Datei aufrufen
        echo "⚙️ Verarbeite: $PDF_FILE"
        "$SHOW_SCRIPT" "$PDF_FILE" > "$TXT_FILE"
        echo "📄 TXT-Datei erstellt: $TXT_FILE"
    fi
done

echo "✅ Verarbeitung abgeschlossen."