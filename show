#!/bin/bash
set -e

if [ -z "$1" ]; then
    echo "Fehler: Kein Dateipfad angegeben."
    exit 1
fi

FILE="./$1"

if [ ! -f "$FILE" ]; then
    echo "Fehler: Datei existiert nicht."
    exit 1
fi

if ! command -v /usr/bin/pdftotext >/dev/null 2>&1; then
    echo "Fehler: pdftotext ist nicht installiert. Bitte installiere poppler-utils."
    exit 1
fi

if [[ "${FILE,,}" == *.pdf ]]; then
    /usr/bin/pdftotext "$FILE" -
else
    echo "Fehler: Datei ist keine PDF."
    echo "$FILE"
    exit 1
fi

