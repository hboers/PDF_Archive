#!/bin/bash

set -e

# Überprüfung auf Eingabeparameter
if [ -z "$1" ]; then
    echo "Fehler: Kein Dateipfad angegeben."
    exit 1
fi

FILE="$1"
OUTFILE="${FILE%.pdf}.txt" # Zieltextdatei basierend auf PDF-Name

# Überprüfen, ob die Eingabedatei existiert
if [ ! -f "$FILE" ]; then
    echo "Fehler: Datei existiert nicht."
    exit 1
fi

# Überprüfen, ob pdftotext verfügbar ist
if ! command -v /usr/bin/pdftotext >/dev/null 2>&1; then
    echo "Fehler: pdftotext ist nicht installiert. Bitte installiere poppler-utils."
    exit 1
fi

# Prüfung auf das PDF-Dateiformat und Ausgabe
if [[ "${FILE,,}" == *.pdf ]]; then
    if [ -f "$OUTFILE" ]; then
        # Wenn die Zieltextdatei existiert, Inhalt mit `cat` ausgeben
        cat "$OUTFILE"
    else
        # Wenn die Zieltextdatei nicht existiert, PDF verarbeiten und Datei erstellen
        /usr/bin/pdftotext "$FILE" "$OUTFILE"
        echo "Inhalt wurde in '$OUTFILE' gespeichert."
        cat "$OUTFILE"
    fi
else
    echo "Fehler: Datei ist keine PDF."
    exit 1
fi